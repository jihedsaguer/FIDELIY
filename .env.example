# ============================================================================
# FIDELIY MVP - Environment Variables Template
# ============================================================================
# Copy this file to .env (local) or .env.production (for deployment)
# NEVER commit actual secret values to Git
# 
# Generate BETTER_AUTH_SECRET with:
#   openssl rand -hex 32
#   OR (Node.js): crypto.randomBytes(32).toString('hex')
#
# Get DATABASE_URL from:
#   Local: postgresql://user:pass@localhost:5432/dbname
#   Supabase: Copy from Project Settings → Database → URI
#   Neon: Copy from Connection String
#
# Get RESEND_API_KEY from:
#   https://resend.com/api-keys
#
# ============================================================================

# BETTER AUTH - REQUIRED
# ============================================================================
# Authentication secret (cryptographic key, generated, not from external service)
# Generate once per environment; reuse in all deployments of that environment
BETTER_AUTH_SECRET=<generate-with-crypto.randomBytes(32).toString('hex')>

# ============================================================================
# DATABASE - PostgreSQL - REQUIRED
# ============================================================================
# Connection URL format: postgresql://[user]:[password]@[host]:[port]/[dbname]
# 
# Local Docker example:
#   postgresql://fideliy_dev:password@localhost:5432/fideliy_dev
# 
# Supabase example:
#   postgresql://postgres.[PROJECT_ID]:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres
#
# Neon example:
#   postgresql://[user]:[password]@[project].neon.tech/[database]?sslmode=require
#
DATABASE_URL=postgresql://fideliy_dev:password@localhost:5432/fideliy_dev

# Optional: Separate database URL for migrations (uses DATABASE_URL if not set)
# MIGRATION_DATABASE_URL=postgresql://[user]:[password]@[host]/[dbname]

# ============================================================================
# EMAIL - Resend - OPTIONAL FOR LOCAL, REQUIRED FOR STAGING/PRODUCTION
# ============================================================================
# Transactional email API key (leave empty for local development; mock will be used)
# Get from: https://resend.com/api-keys
# Format: Alphanumeric, ~30+ characters
# 
# RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Sender email address (used in From: header for all transactional emails)
# Recommended: noreply@yourdomain.com or no-reply@resend.com (default)
# EMAIL_FROM=noreply@fideliy.tn

# Webhook secret (only if Resend webhooks are implemented; not in Release 1 MVP)
# RESEND_WEBHOOK_SECRET=<resend-webhook-secret>

# ============================================================================
# SMS PROVIDER - OPTIONAL FOR LOCAL (MOCK), REQUIRED FOR STAGING/PRODUCTION
# ============================================================================
# SMS Provider name (must NOT be "mock" in production)
# Options: mock (development), twilio, vonage, infobip, or other vendor
# 
# Local development: keep as "mock" (OTP codes logged to console)
# Staging/Production: set to actual vendor name (blocks SMS mock; prevents deploying test code)
#
SMS_PROVIDER=mock

# Provider-specific credentials (only when using real SMS vendor)
# Pending SMS vendor selection (Phase 1A task)
# Examples:
#   Twilio:  SMS_VENDOR_API_KEY=your_twilio_account_sid:auth_token
#   Vonage:  SMS_VENDOR_API_KEY=your_vonage_api_key
#   Infobip: SMS_VENDOR_API_KEY=your_infobip_api_key
#
# SMS_VENDOR_API_KEY=<provider-specific-key>
# SMS_VENDOR_API_SECRET=<provider-specific-secret-if-needed>
# SMS_SENDER_ID=FIDELIY  # Optional: display name for SMS sender

# ============================================================================
# NODE ENVIRONMENT - REQUIRED
# ============================================================================
# Environment identifier (triggers validation, logging, security checks)
# Values: development, staging, production
# 
# Behavior differences:
#   development: Relaxed validation, verbose logging, mock SMS/email allowed
#   staging:     Full validation, structured logging, real SMS/email required
#   production:  Strict validation, error-only logging, mock SMS/email REJECTED
#
NODE_ENV=development

# ============================================================================
# SERVER CONFIGURATION - REQUIRED
# ============================================================================
# Backend port
PORT=3000

# Frontend URL (for CORS and redirect validation)
# Local: http://localhost:5173 (Vite dev server)
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# Backend public URL (for emails, QR codes, redirects)
# Used in password reset links, QR code targets, etc.
# Local: http://localhost:3000
# Production: https://api.yourdomain.com
API_PUBLIC_URL=http://localhost:3000

# CORS origin (comma-separated for multiple origins)
# Local: http://localhost:5173
# Production: https://yourdomain.com
# CORS_ORIGIN=http://localhost:5173

# ============================================================================
# LOGGING & DEBUGGING - OPTIONAL
# ============================================================================
# Log level (verbosity)
# Options: error, warn, info, debug, verbose
# Default: info (if not set)
LOG_LEVEL=debug

# Enable debug mode (verbose HTTP logging, stack traces)
# Values: true, false
# DEBUG=false

# ============================================================================
# FRONTEND PUBLIC CONFIGURATION
# ============================================================================
# Note: VITE_ prefixed variables are compiled into frontend bundle at build time
# They are visible in browser DevTools and network requests
# NEVER put secrets here
#
# Frontend API base URL (how frontend calls backend)
# Used for fetch() calls; must be accessible from browser
# Local: http://localhost:3000/api
# Production: https://api.yourdomain.com/api
# VITE_API_BASE_URL=http://localhost:3000/api

# ============================================================================
# ADVANCED / OPTIONAL
# ============================================================================
# Session expiration (seconds)
# Default: 604800 (7 days)
# SESSION_EXPIRY_SECONDS=604800

# Rate limiting (requests per window)
# Default: 100 requests per 15 minutes
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000

# CSRF protection (true/false)
# Default: true
# CSRF_ENABLED=true

# Trust proxy (for X-Forwarded-For header; important behind reverse proxy)
# Default: false
# TRUST_PROXY=true

# ============================================================================
# OPTIONAL: DATABASE CONNECTION POOLING (Advanced)
# ============================================================================
# Connection pool size (development: 5-10, production: 20-50)
# DB_POOL_SIZE=10

# Connection timeout (milliseconds)
# DB_CONNECTION_TIMEOUT=5000

# Idle timeout (milliseconds before connection closes)
# DB_IDLE_TIMEOUT=30000

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
