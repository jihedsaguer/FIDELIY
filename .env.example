# FIDELIY - Environment Configuration Example
# Names and descriptions only. Copy to .env (root, used by docker compose) and backend/.env,
# then fill in your own values. Never commit real values.

# ---------------------------------------------------------------------------
# Root .env (read by docker-compose.yml)
# ---------------------------------------------------------------------------
# Password for the local Docker PostgreSQL role (database: fideliy_dev)
POSTGRES_PASSWORD=
# Secret used by Better Auth to sign sessions; generate a long random value
# (for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET=
# Optional: browser origin of the frontend (compose default: http://localhost:5173)
FRONTEND_URL=
# Server key (hex or base64, at least 32 bytes) from which each customer personal QR and
# short ID are derived (DECISIONS.md #20). Required in production (startup fails without it).
# Keep it separate from BETTER_AUTH_SECRET. Replacing it invalidates every existing QR.
CUSTOMER_QR_SECRET=

# ---------------------------------------------------------------------------
# Backend runtime (backend/.env when running outside Docker; compose sets these in Docker)
# ---------------------------------------------------------------------------
# PostgreSQL connection string, format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Local Docker: host is "postgres" inside compose and "localhost" from the host machine.
# Deployment: the Neon connection string.
DATABASE_URL=
# Public base URL of the backend used by Better Auth (compose: http://localhost:3000)
BETTER_AUTH_URL=
# development | test | production
NODE_ENV=
# Backend HTTP port (default 3000)
PORT=

# ---------------------------------------------------------------------------
# Phone OTP / SMS (Release 2; no SMS vendor is selected)
# ---------------------------------------------------------------------------
# "mock" by default. Startup validation rejects "mock" when NODE_ENV=production.
SMS_PROVIDER=
# Reserved for the future SMS vendor integration
SMS_VENDOR_API_KEY=

# ---------------------------------------------------------------------------
# Local test utility (development only; never enable in production)
# Used by: npm run retrieve:test-otp --prefix backend
# ---------------------------------------------------------------------------
ENABLE_LOCAL_TEST_AUTH=false
LOCAL_TEST_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# Frontend (frontend/.env.local or compose environment)
# ---------------------------------------------------------------------------
# API base path or URL (default /api, proxied by the Vite dev server)
VITE_API_BASE_URL=
# Vite dev-server proxy target for /api (compose: http://backend:3000; default http://localhost:3000)
VITE_BACKEND_PROXY_TARGET=

# ---------------------------------------------------------------------------
# Opt-in database integration tests (set to true; require a running, migrated PostgreSQL)
# ---------------------------------------------------------------------------
# RUN_AUTH_INTEGRATION, RUN_BRANCH_INTEGRATION, RUN_BUSINESS_SETUP_INTEGRATION,
# RUN_CUSTOMER_MEMBERSHIP_INTEGRATION, RUN_LOGO_UPLOAD_INTEGRATION,
# RUN_LOYALTY_LEDGER_INTEGRATION, RUN_PROGRAM_LIFECYCLE_INTEGRATION,
# RUN_PROGRAMS_INTEGRATION, RUN_DB_POC
