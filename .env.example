# FIDELIY - Environment Configuration Example

# Phase 3: Local OTP Retrieval Utility (Development Only)
# Set these to retrieve test OTPs for customer authentication testing.
# DO NOT enable in production.
ENABLE_LOCAL_TEST_AUTH=false
LOCAL_TEST_PHONE_NUMBER=

# Required services (see backend/.env for full list)
# Backend uses: DATABASE_URL, NODE_ENV, BETTER_AUTH_SECRET, etc.
# 21st.dev API Key (MCP authentication)
# Get your API key from: https://21st.dev/mcp
# API_KEY_21ST=21st_sk_...
