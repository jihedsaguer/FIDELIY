// Cloudflare Worker for the FIDELIY frontend (static SPA + /api proxy).
// BACKEND_ORIGIN is NOT set here: pass it at deploy time with
//   npx wrangler deploy --var BACKEND_ORIGIN:<https backend origin>
// No account ID here either (taken from the deploy environment).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fideliy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-19",
  "assets": {
    // Output of `npm run build` (vite).
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these reach the Worker before assets; everything else is served
    // straight from assets (SPA fallback to index.html).
    "run_worker_first": ["/api", "/api/*"]
  },
  // Keep-alive: the Render free web service sleeps after ~15 minutes without
  // traffic. This cron runs the Worker's `scheduled` handler every 10 minutes,
  // which sends one GET to ${BACKEND_ORIGIN}/api/health. That route does not
  // touch the database (no cookie is sent), so Neon can still scale to zero.
  // To turn it off: set "crons": [] and redeploy (README "Keep-alive").
  // Deleting the key is not enough: wrangler then leaves the deployed
  // schedule untouched.
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
